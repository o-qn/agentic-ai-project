HR_DATA_DIR=./data
HR_CREDENTIALS=/home/qn/Documents/credentials.json
HR_ROOT_FOLDER=14lhL4U0mzSOSvPUXIV6Sv20Kfx1aeTbr
HR_OLLAMA_URL=http://127.0.0.1:11434
# Optional absolute binary/model-store paths for a workspace Ollama installation.
# HR_OLLAMA_BINARY=/path/to/ollama
# OLLAMA_MODELS=/path/to/models
# Set explicitly after `ollama list`; run model-check before enabling processing.
HR_MODEL=
HR_EMBED_MODEL=
HR_PORT=8787
HR_SCAN_SECONDS=300
HR_REQUEST_TIMEOUT=120
HR_JOB_SECONDS=900
HR_MAX_FILE_MB=20
HR_MAX_PAGES=40
HR_CONTEXT=16384
HR_OUTPUT_TOKENS=2048
HR_THREADS=6

# Owner is allowed. List any additional verified HR users/groups by email.
HR_ALLOWED_PRINCIPALS=

# Install matching Tesseract language packs before enabling another language.
HR_OCR_LANGUAGE=eng

# Hosted assessment (optional). Keep Ollama for CPU embeddings.
HR_MODEL_PROVIDER=ollama
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_API_KEY=
# For a synthetic trial, leave HR_MODEL unchanged and select a trial model:
HR_ROUTER_TRIAL_MODEL=deepseek-v4-flash
# After a successful trial: set HR_MODEL_PROVIDER=agentrouter and HR_MODEL to that model.

# Hosted embeddings (optional). Default stays local Ollama on the CPU; set all three
# to activate. The key is read from VOYAGE_API_KEY or a private VOYAGE_API_KEY.txt file
# (never committed, never passed as a CLI argument). Activating a hosted model changes
# the embedding-index identity, which rebuilds the search index WITHOUT rescoring.
HR_EMBED_PROVIDER=ollama
# HR_EMBED_PROVIDER=voyage
HR_EMBED_HOSTED_MODEL=
HR_EMBED_URL=https://api.voyageai.com/v1/embeddings
VOYAGE_API_KEY=
HR_EMBED_BATCH=64
HR_EMBED_RPM=60

# Genuine CLI assessment route; Linux bubblewrap is required.
HR_CODEX_BINARY=/usr/lib/chatgpt/resources/codex
HR_ROUTER_MAX_TURNS=6
HR_ROUTER_DAILY_REQUESTS=12
# Limits count CLI launches, not verified billable gateway requests/tokens.

# PostgreSQL + pgvector mirror (optional, later step). Default is empty: the whole Postgres
# path stays inert and SQLite is the only, authoritative store. The DSN contains a password,
# so it is read from HR_POSTGRES_URL / POSTGRES_URL or a private POSTGRES_URL.txt file (never
# committed, never passed as a CLI argument, never logged). Workflow, once a database exists:
#   hr-agent pg-migrate    # copy SQLite -> Postgres (read-only on SQLite; refuses to clobber)
#   hr-agent pg-validate   # verify row counts + exact scores; only then is vector search used
#   hr-agent pg-rollback   # drop the mirror schema and disable vector search (SQLite untouched)
# HR_POSTGRES_URL=postgresql://hr:password@127.0.0.1:5432/hr
HR_PG_SCHEMA=hr_vectors
